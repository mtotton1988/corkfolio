# Your cellar must never reach a public repo.
#
# If cellar.local.csv or home.local.csv sits next to index.html, the app offers
# a one-tap "Load the export in this folder" button. That is a convenience for
# running the app locally - it saves hunting through a file picker every time
# storage is cleared - and these are the only two files that could leak your
# holdings, so they are ignored here rather than relied on to be remembered.
cellar.local.csv
home.local.csv

# Scratch folders used while testing the importer.
_seed/

# Archived earlier versions live one directory up, but ignore them if they
# ever get copied in here.
*.bak
